{
  "name": "next-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "start": "next start",
    "storage:down": "node scripts/storage-down.mjs",
    "storage:logs": "docker compose --env-file .env.local logs --follow rustfs",
    "storage:up": "docker compose --env-file .env.local up --detach --wait --wait-timeout 60 rustfs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-query": "^5.101.4",
    "@xstate/react": "^6.1.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.22.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
